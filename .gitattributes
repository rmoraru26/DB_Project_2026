# Shell scripts and Docker files must keep LF endings, also on Windows
# checkouts with core.autocrlf=true; bash in the containers rejects CRLF.
*.sh text eol=lf
Dockerfile text eol=lf
Makefile text eol=lf
*.cnf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.ps1 text eol=crlf
.env.example text eol=lf
*.sql text eol=lf
