# Copy to .env and replace every value (or run: bash scripts/make_env.sh, which
# make up does for you). Never commit .env.
# Generate values for example with:  openssl rand -hex 16

# MariaDB root account (Docker only).
MARIADB_ROOT_PASSWORD=change-me-root-password

# Web application database account campus_app.
# 12+ characters of A-Z a-z 0-9 . _ -
CAMPUS_APP_PASSWORD=change-me-app-password

# Flask session signing key.
SECRET_KEY=change-me-flask-secret-key

# Host ports (bound to 127.0.0.1). 5080 rather than 5000: on macOS 12+ the
# AirPlay receiver already listens on port 5000.
MARIADB_PORT=3307
WEB_PORT=5080

# Uncomment to run a second, independent copy (own containers and volumes):
# COMPOSE_PROJECT_NAME=campus-audit-test

# For running the app outside Docker (python frontend/app.py):
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=campus_app
DB_PASSWORD=change-me-app-password
DB_NAME=university_resources
FLASK_PORT=5080
